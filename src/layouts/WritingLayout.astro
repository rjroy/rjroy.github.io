---
import BaseLayout from "./BaseLayout.astro"
import { getCollection } from "astro:content"

interface Props {
  title: string
  description: string
  date?: Date
  tags: string[]
  id: string
}

const { title, description, date, tags, id } = Astro.props

// Check if this is a series index page (Astro strips "/index", so top-level entries have no "/" in their ID)
const isSeriesIndex = !id.includes("/")
const folder = id.split("/")[0]

let seriesEssays: Awaited<ReturnType<typeof getCollection<"writing">>>[number][] = []
if (isSeriesIndex) {
  const allWriting = await getCollection("writing")
  seriesEssays = allWriting
    .filter((entry) => entry.id.startsWith(folder + "/") && entry.id !== id)
    .sort((a, b) => {
      // Sort by order if available, then by date, then by title
      if (a.data.order !== undefined && b.data.order !== undefined) {
        return a.data.order - b.data.order
      }
      if (a.data.date && b.data.date) {
        return a.data.date.getTime() - b.data.date.getTime()
      }
      return a.data.title.localeCompare(b.data.title)
    })
}

const formattedDate = date?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
})

function entryIdToUrl(entryId: string): string {
  return `/writing/${entryId}/`
}
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="mb-8">
      <h1>{title}</h1>
      {
        formattedDate && (
          <time
            datetime={date?.toISOString()}
            class="text-[var(--color-text-muted)] text-sm"
          >
            {formattedDate}
          </time>
        )
      }
      {description && <p class="text-[var(--color-text-muted)] mt-2">{description}</p>}
    </header>

    <div class="prose">
      <slot />
    </div>

    {
      seriesEssays.length > 0 && (
        <nav class="mt-12 pt-8 border-t border-[var(--color-border)]">
          <h2 class="text-lg mb-4">In This Series</h2>
          <ol class="list-none p-0 space-y-3">
            {seriesEssays.map((essay) => (
              <li>
                <a
                  href={entryIdToUrl(essay.id)}
                  class="card block p-3 no-underline"
                >
                  <span class="font-heading text-[var(--color-gold)]">
                    {essay.data.title}
                  </span>
                  {essay.data.description && (
                    <p class="text-sm text-[var(--color-text-muted)] mt-1 mb-0">
                      {essay.data.description}
                    </p>
                  )}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </article>
</BaseLayout>
