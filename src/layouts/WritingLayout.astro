---
import BaseLayout from "./BaseLayout.astro"
import Comments from "../components/Comments.astro"
import { getCollection } from "astro:content"

interface Props {
  title: string
  description: string
  date?: Date
  tags: string[]
  id: string
  readingMinutes?: number
}

const { title, description, date, tags, id, readingMinutes = 0 } = Astro.props

// Check if this is a series index page (Astro strips "/index", so top-level entries have no "/" in their ID)
const isSeriesIndex = !id.includes("/")
const folder = id.split("/")[0]

let seriesEssays: Awaited<ReturnType<typeof getCollection<"writing">>>[number][] = []
if (isSeriesIndex) {
  const allWriting = await getCollection("writing")
  seriesEssays = allWriting
    .filter((entry) => entry.id.startsWith(folder + "/") && entry.id !== id)
    .sort((a, b) => {
      // Sort by order if available, then by date, then by title
      if (a.data.order !== undefined && b.data.order !== undefined) {
        return a.data.order - b.data.order
      }
      if (a.data.date && b.data.date) {
        return a.data.date.getTime() - b.data.date.getTime()
      }
      return a.data.title.localeCompare(b.data.title)
    })
}

const formattedDate = date?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
})

// Drop vault-organization tags from the visible meta line.
const structuralTags = new Set(["area", "project", "index"])
const metaTags = tags.filter((t) => !structuralTags.has(t))

const url = (entryId: string) => `/writing/${entryId.toLowerCase()}/`
---

<BaseLayout title={title} description={description} contained={false}>
  <div class="read-head">
    <div class="container prose-col">
      <div class="crumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/writing/">Writing</a>
        <span>/</span>
        <span>{title}</span>
      </div>
      <h1>{title}</h1>
      <div class="read-meta">
        {formattedDate && <span>{formattedDate}</span>}
        {formattedDate && readingMinutes > 0 && <span class="dot" />}
        {readingMinutes > 0 && <span>{readingMinutes} min read</span>}
        {metaTags.length > 0 && <span class="dot" />}
        {metaTags.length > 0 && <span>{metaTags.join(" · ")}</span>}
      </div>
    </div>
  </div>

  <article class="article">
    <div class="container prose-col">
      {description && <p class="drop-lead">{description}</p>}
      <slot />
    </div>
  </article>

  {
    seriesEssays.length > 0 && (
      <div class="read-foot">
        <div class="container">
          <span class="eyebrow">In this series</span>
          <div class="backlinks" style="margin-top: var(--space-6);">
            {seriesEssays.map((essay) => (
              <a class="backlink" href={url(essay.id)}>
                <div class="bl-kind">Writing · Series</div>
                <h4>{essay.data.title}</h4>
                {essay.data.description && <p>{essay.data.description}</p>}
              </a>
            ))}
          </div>
        </div>
      </div>
    )
  }

  <div class="container prose-col" style="margin-top: var(--space-12);">
    <Comments />
  </div>
</BaseLayout>
