---
import BaseLayout from "./BaseLayout.astro"
import Comments from "../components/Comments.astro"
import { getCollection } from "astro:content"

interface Props {
  title: string
  description: string
  status: "active" | "paused" | "graduated"
  tags: string[]
  id: string
  date?: Date
}

const { title, description, status, tags, id, date } = Astro.props

// Find sibling pages in the same folder
const folder = id.split("/")[0]
const allIdeas = await getCollection("ideas")
const siblings = allIdeas
  .filter((entry) => entry.id.startsWith(folder + "/") && entry.id !== id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title))

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1)
const structuralTags = new Set(["area", "project", "index"])
const metaTags = tags.filter((t) => !structuralTags.has(t))

const formattedDate = date?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
})

const url = (entryId: string) => `/ideas/${entryId.toLowerCase()}/`
---

<BaseLayout title={title} description={description} contained={false}>
  <div class="read-head">
    <div class="container prose-col">
      <div class="crumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/ideas/">Ideas</a>
        <span>/</span>
        <span>{title}</span>
      </div>
      <h1>{title}</h1>
      <div class="read-meta">
        <span class:list={["status", status]}>{cap(status)}</span>
        {formattedDate && <span class="dot" />}
        {formattedDate && <span>{formattedDate}</span>}
        {metaTags.length > 0 && <span class="dot" />}
        {metaTags.length > 0 && <span>{metaTags.join(" · ")}</span>}
      </div>
    </div>
  </div>

  <article class="article">
    <div class="container prose-col">
      {description && <p class="drop-lead">{description}</p>}
      <slot />
    </div>
  </article>

  {
    siblings.length > 0 && (
      <div class="read-foot">
        <div class="container">
          <span class="eyebrow">Related pages</span>
          <div class="backlinks" style="margin-top: var(--space-6);">
            {siblings.map((sibling) => (
              <a class="backlink" href={url(sibling.id)}>
                <div class="bl-kind">Idea</div>
                <h4>{sibling.data.title}</h4>
                {sibling.data.description && <p>{sibling.data.description}</p>}
              </a>
            ))}
          </div>
        </div>
      </div>
    )
  }

  <div class="container prose-col" style="margin-top: var(--space-12);">
    <Comments />
  </div>
</BaseLayout>
