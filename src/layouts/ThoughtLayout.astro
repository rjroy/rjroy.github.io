---
import BaseLayout from "./BaseLayout.astro"
import Comments from "../components/Comments.astro"

interface Props {
  title: string
  date: Date
  linkedIdea?: string
}

const { title, date, linkedIdea } = Astro.props
const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
})
---

<BaseLayout title={title} contained={false}>
  <div class="read-head">
    <div class="container prose-col">
      <div class="crumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/thoughts/">Thoughts</a>
        <span>/</span>
        <span>{title}</span>
      </div>
      <h1>{title}</h1>
      <div class="read-meta">
        <span>{formattedDate}</span>
        {linkedIdea && <span class="dot" />}
        {
          linkedIdea && (
            <span>
              Related: <a href={linkedIdea}>{linkedIdea}</a>
            </span>
          )
        }
      </div>
    </div>
  </div>

  <article class="article">
    <div class="container prose-col">
      <slot />
    </div>
  </article>

  <div class="container prose-col" style="margin-top: var(--space-12);">
    <Comments />
  </div>
</BaseLayout>
