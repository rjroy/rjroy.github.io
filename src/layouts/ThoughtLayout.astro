---
import BaseLayout from "./BaseLayout.astro"

interface Props {
  title: string
  date: Date
  standalone: boolean
  linkedIdea?: string
}

const { title, date, standalone, linkedIdea } = Astro.props
const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
})
---

<BaseLayout title={title}>
  {
    standalone ? (
      <article>
        <header class="mb-8">
          <h1 class="mb-2">{title}</h1>
          <time
            datetime={date.toISOString()}
            class="text-[var(--color-text-muted)] text-sm"
          >
            {formattedDate}
          </time>
          {linkedIdea && (
            <p class="mt-2 text-sm">
              Related: <a href={linkedIdea}>{linkedIdea}</a>
            </p>
          )}
        </header>
        <div class="prose">
          <slot />
        </div>
      </article>
    ) : (
      <article class="py-4">
        <time
          datetime={date.toISOString()}
          class="text-[var(--color-text-muted)] text-sm block mb-4"
        >
          {formattedDate}
        </time>
        <div>
          <slot />
        </div>
      </article>
    )
  }
</BaseLayout>
