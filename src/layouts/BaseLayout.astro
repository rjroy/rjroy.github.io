---
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import "../styles/global.css"
import { IDENTITY_MARK, SITE_DESCRIPTION, SITE_NAME } from "../site"

interface Props {
  title: string
  description?: string
  /** When false, the page renders full-bleed and manages its own
      containers (e.g. the homepage hero). Defaults to a centered column. */
  contained?: boolean
}

const { title, description = SITE_DESCRIPTION, contained = true } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={IDENTITY_MARK} />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <title>{title} | {SITE_NAME}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL("/assets/two-cities.webp", Astro.site)} />
    <meta property="og:type" content="website" />
    <!-- RSS autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <!-- Prevent flash of wrong theme. Default dark; honor the saved
         preference (and migrate the legacy "theme" key if present). -->
    <script is:inline>
      ;(function () {
        var t = localStorage.getItem("rbc-theme") || localStorage.getItem("theme")
        if (t !== "light" && t !== "dark") t = "dark"
        document.documentElement.setAttribute("data-theme", t)
      })()
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <Nav />
    {
      /* min-w-0 lets the main flex item shrink below its content's intrinsic
         width (e.g. a wide code block) instead of forcing horizontal overflow. */
      contained ? (
        <main class="flex-1 w-full min-w-0 max-w-3xl mx-auto px-4 py-8">
          <slot />
        </main>
      ) : (
        <main class="flex-1 w-full min-w-0">
          <slot />
        </main>
      )
    }
    <Footer />
  </body>
</html>
