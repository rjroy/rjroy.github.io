---
import BaseLayout from "./BaseLayout.astro"
import Comments from "../components/Comments.astro"

interface Props {
  title: string
  description: string
  status: "active" | "maintained" | "archived"
  tags: string[]
}

const { title, description, status, tags } = Astro.props

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1)
const structuralTags = new Set(["area", "project", "index"])
const metaTags = tags.filter((t) => !structuralTags.has(t))
---

<BaseLayout title={title} description={description} contained={false}>
  <div class="read-head">
    <div class="container prose-col">
      <div class="crumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/projects/">Projects</a>
        <span>/</span>
        <span>{title}</span>
      </div>
      <h1>{title}</h1>
      <div class="read-meta">
        <span class:list={["status", status]}>{cap(status)}</span>
        {metaTags.length > 0 && <span class="dot" />}
        {metaTags.length > 0 && <span>{metaTags.join(" · ")}</span>}
      </div>
    </div>
  </div>

  <article class="article">
    <div class="container prose-col">
      {description && <p class="drop-lead">{description}</p>}
      <slot />
    </div>
  </article>

  <div class="container prose-col" style="margin-top: var(--space-12);">
    <Comments />
  </div>
</BaseLayout>
