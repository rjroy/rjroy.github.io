---
const currentPath = Astro.url.pathname

const navLinks = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/projects/" },
  { label: "Writing", href: "/writing/" },
  { label: "Thoughts", href: "/thoughts/" },
]

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/"
  return currentPath.startsWith(href)
}
---

<nav class="nav">
  <div class="nav-inner">
    <a class="brand" href="/">
      <img class="shield-dark" src="/assets/logo-shield-dark.png" alt="Crest" />
      <img class="shield-light" src="/assets/logo-shield-light.png" alt="Crest" />
      <span class="brand-name">Broadcast Cache<small>Ron's working notebook</small></span>
    </a>

    <div class="nav-links">
      {
        navLinks.map((link) => (
          <a
            class:list={["nav-link", isActive(link.href) && "active"]}
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <button class="icon-btn" id="themeToggle" aria-label="Toggle light and dark">
      <svg
        class="sun-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><circle cx="12" cy="12" r="4"></circle><path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        ></path></svg
      >
      <svg
        class="moon-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
      >
    </button>

    <button
      class="icon-btn nav-toggle"
      id="navToggle"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg
        class="menu-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"></path></svg
      >
      <svg
        class="close-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        hidden><path d="M6 6l12 12M18 6L6 18"></path></svg
      >
    </button>
  </div>

  <div class="nav-mobile" id="navMobile">
    {
      navLinks.map((link) => (
        <a
          class:list={["nav-link", isActive(link.href) && "active"]}
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </div>
</nav>

<script is:inline>
  ;(function () {
    var root = document.documentElement

    // The crest and sun/moon icons swap purely in CSS off [data-theme], so the
    // toggle only has to flip the attribute and persist the choice.
    var toggle = document.getElementById("themeToggle")
    if (toggle) {
      toggle.addEventListener("click", function () {
        var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark"
        root.setAttribute("data-theme", next)
        try {
          localStorage.setItem("rbc-theme", next)
        } catch (e) {}
      })
    }

    // Keep the theme in sync if it's changed in another tab.
    window.addEventListener("storage", function (e) {
      if (e.key === "rbc-theme" && (e.newValue === "light" || e.newValue === "dark")) {
        root.setAttribute("data-theme", e.newValue)
      }
    })

    // Mobile menu
    var navToggle = document.getElementById("navToggle")
    var navMobile = document.getElementById("navMobile")
    if (navToggle && navMobile) {
      navToggle.addEventListener("click", function () {
        var open = navMobile.classList.toggle("open")
        navToggle.setAttribute("aria-expanded", String(open))
        navToggle.querySelector(".menu-icon").hidden = open
        navToggle.querySelector(".close-icon").hidden = !open
      })
    }
  })()
</script>
