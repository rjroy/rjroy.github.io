---
// Giscus comments component
// Prerequisites: GitHub Discussions must be enabled on rjroy/rjroy.github.io
// with a dedicated "Comments" category.
//
// To get repo-id and category-id:
// 1. Enable Discussions on the repo
// 2. Create a "Comments" category
// 3. Visit giscus.app, enter repo name
// 4. Copy the data-repo-id and data-category-id values
---

<section class="mt-12 pt-8 border-t border-[var(--color-border)]">
  <h2 class="text-lg mb-4">Comments</h2>
  <script
    src="https://giscus.app/client.js"
    data-repo="rjroy/rjroy.github.io"
    data-repo-id="R_kgDOQwxbpg"
    data-category="Comments"
    data-category-id="DIC_kwDOQwxbps4C2EzX"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang="en"
    crossorigin="anonymous"
    async
  ></script>
</section>
