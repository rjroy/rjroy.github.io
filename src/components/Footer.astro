---
import { SITE_NAME } from "../site"

const currentYear = new Date().getFullYear()
---

<footer class="foot">
  <div class="container foot-inner">
    <div class="foot-brand">
      <div class="brand-name">{SITE_NAME}</div>
      <p>
        A place to share a curated selection of what I'm learning about working with AI, and
        reflections on what it means to work with it.
      </p>
    </div>
    <div class="foot-cols">
      <div class="foot-col">
        <h4>Explore</h4>
        <a href="/projects/">Projects</a>
        <a href="/writing/">Writing</a>
        <a href="/thoughts/">Thoughts</a>
      </div>
      <div class="foot-col">
        <h4>Elsewhere</h4>
        <a href="https://github.com/rjroy" target="_blank" rel="noopener">GitHub</a>
        <a href="https://github.com/rjroy/memory-loop" target="_blank" rel="noopener"
          >Memory Loop source</a
        >
        <a href="/rss.xml">RSS feed</a>
      </div>
    </div>
  </div>
  <div class="container">
    <div class="foot-legal">
      <span>&copy; {currentYear} Ron Roy</span>
      <span
        >Content: CC BY 4.0 · <a href="/brand-artwork-license.txt">Brand artwork excluded</a></span
      >
      <span>Built with Astro · hosted on GitHub Pages</span>
    </div>
  </div>
</footer>
