---
import BaseLayout from "../layouts/BaseLayout.astro"
import { getCollection } from "astro:content"

const writing = await getCollection("writing")
const projects = await getCollection("projects")
const thoughts = await getCollection("thoughts")

// Top-level entries only. Astro strips "/index" from folder-based IDs, so a
// top-level entry's ID has no slash; sub-notes look like "Folder/sub".
const topLevel = (entries: any[]) => entries.filter((e) => !e.id.includes("/"))

const writingTop = topLevel(writing)
const projectsTop = topLevel(projects)

const counts = {
  projects: projectsTop.length,
  writing: writingTop.length,
  thoughts: thoughts.length,
}

// Sort by date (newest first); undated entries sort last, then alphabetically.
const byDateDesc = (a: any, b: any) => {
  if (a.data.date && b.data.date) return b.data.date.getTime() - a.data.date.getTime()
  if (a.data.date) return -1
  if (b.data.date) return 1
  return a.data.title.localeCompare(b.data.title)
}

// Featured entries first, then most recent, capped at n.
const curate = (entries: any[], n: number) => {
  const featured = entries.filter((e) => e.data.featured).sort(byDateDesc)
  const rest = entries.filter((e) => !e.data.featured).sort(byDateDesc)
  return [...featured, ...rest].slice(0, n)
}

const tendingProjects = curate(projectsTop, 1)
const leadProject = tendingProjects.length > 0 ? tendingProjects[0] : null
const tendingWriting = curate(writingTop, 2)

const url = (id: string, section: string) => `/${section}/${id.toLowerCase()}/`
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1)

const areas = [
  {
    num: "01 / Projects",
    title: "Projects",
    body: "Things I've built with clear goals, from Memory Loop to the Guild Hall.",
    foot: `${counts.projects} shipped`,
    href: "/projects/",
    accent: "var(--ember-500)",
  },
  {
    num: "02 / Writing",
    title: "Writing",
    body: "Essays and exploratory long-form work, published while the thinking is still in motion.",
    foot: `${counts.writing} ${counts.writing === 1 ? "piece" : "pieces"}`,
    href: "/writing/",
    accent: "var(--verdigris-500)",
  },
  {
    num: "03 / Thoughts",
    title: "Thoughts",
    body: "Short reflections and observations, dated as they land on the page.",
    foot: `${counts.thoughts} ${counts.thoughts === 1 ? "note" : "notes"}`,
    href: "/thoughts/",
    accent: "var(--brass-500)",
  },
]
---

<BaseLayout
  title="Home"
  description="A working notebook for thinking and building alongside AI: short reflections, shipped projects, and long-form writing."
  contained={false}
>
  <!-- Hero -->
  <header class="hero">
    <div class="hero-bg"></div>
    <div class="hero-vignette"></div>
    <div class="hero-inner">
      <div class="container">
        <div class="hero-kicker">
          Ron's Broadcast Cache &nbsp;·&nbsp; a digital garden since 2025
        </div>
        <h1>
          A working notebook for thinking and <span class="gild">building</span>
          alongside AI.
        </h1>
        <p class="hero-lead">
          Thirty years a developer, now working out what the craft becomes when AI is part of the work. This
          is the public side of that workshop: short reflections, projects that shipped, and long-form writing that includes exploratory work.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#areas"> Wander the garden </a>
          <a class="btn btn-ghost btn-on-dark" href="#about">What is this place?</a>
        </div>
      </div>
    </div>
  </header>

  <!-- Currently tending -->
  {
    (leadProject || tendingWriting.length > 0) && (
      <section class="section tending" id="tending">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Currently tending</span>
            <h2>What I'm working on right now.</h2>
            <p>Recent work, in progress and just shipped.</p>
          </div>
          <div class="feature-grid">
            {leadProject && (
              <a class="feature-card lead-card" href={url(leadProject.id, "projects")}>
                {leadProject.data.cover && (
                  <div class="feature-thumb">
                    <img
                      src={leadProject.data.cover}
                      alt={leadProject.data.title}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="feature-body">
                  <span class="kind">Project · {cap(leadProject.data.status)}</span>
                  <h3>{leadProject.data.title}</h3>
                  <p>{leadProject.data.description}</p>
                </div>
              </a>
            )}
            {tendingWriting.map((piece) => (
              <a class="feature-card" href={url(piece.id, "writing")}>
                <div class="feature-body">
                  <span class="kind">Writing</span>
                  <h3>{piece.data.title}</h3>
                  <p>{piece.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Where to begin -->
  <section class="section" id="areas">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Where to begin</span>
          <h2>Three places to start.</h2>
        <p>
          Projects, long-form writing, and shorter reflections. Start wherever the curiosity lands.
        </p>
      </div>
      <div class="areas">
        {
          areas.map((area) => (
            <a class="area-card" href={area.href} style={`--accent: ${area.accent};`}>
              <span class="area-num">{area.num}</span>
              <h3>{area.title}</h3>
              <p>{area.body}</p>
              <span class="area-foot">
                {area.foot} <span class="arrow">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section" id="about" style="scroll-margin-top: 84px;">
    <div class="container">
      <div class="about">
        <div class="about-portrait">
          <img
            src="/assets/guild-hall.webp"
            alt="A workshop full of artisans, mages, and makers"
            loading="lazy"
            decoding="async"
          />
          <div class="frame-tint"></div>
        </div>
        <div>
          <span class="eyebrow">About this place</span>
          <h2>The public side of a private workshop.</h2>
          <p>
            I'm Ron, a developer for nearly thirty years. The past couple of years changed how this
            work gets done, and I'm not standing to the side of that shift. This space tracks the
            exploration: projects I'm building with AI tools, and what it actually means to work
            alongside them.
          </p>
          <p>
            The goal here is learning, not publishing. But writing is the most accessible way to
            make that work shareable. I hope something here is useful, or at least gets you asking
            your own version of the same questions.
          </p>
          <div class="ghost-note">
            <strong>How this is written.</strong> I work with Claude Code as an editor and ghostwriter.
            The ideas, direction, and editorial judgment are mine; Claude helps get the words on the page.
            I'm not hiding that, and I'm actively working to write more of it myself over time.
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="flourish-rule">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><circle cx="12" cy="12" r="3"></circle><path
          d="M12 2l1.8 4.2M12 22l-1.8-4.2M2 12l4.2-1.8M22 12l-4.2 1.8M5 5l3.5 3.5M19 19l-3.5-3.5M19 5l-3.5 3.5M5 19l3.5-3.5"
        ></path></svg
      >
    </div>
  </div>
</BaseLayout>
