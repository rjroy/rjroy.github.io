---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getCollection } from "astro:content"

const allIdeas = await getCollection("ideas")

// Top-level ideas only (Astro strips "/index", so top-level entries have no "/" in their ID)
const topLevelIdeas = allIdeas
  .filter((entry) => !entry.id.includes("/"))
  .sort((a, b) => {
    const statusOrder = { active: 0, paused: 1, graduated: 2 }
    const diff = statusOrder[a.data.status] - statusOrder[b.data.status]
    if (diff !== 0) return diff
    return a.data.title.localeCompare(b.data.title)
  })

const url = (id: string) => `/ideas/${id.toLowerCase()}/`
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1)
---

<BaseLayout
  title="Ideas"
  description="Developing thoughts, explorations, and work in progress."
  contained={false}
>
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">Still germinating</span>
      <h1>Ideas</h1>
      <p class="page-lead">
        Developing thoughts and explorations at every stage of ripeness — the ones still taking
        shape in the dark.
      </p>
    </div>
  </div>

  <section class="section-sm">
    <div class="container">
      <div class="backlinks">
        {
          topLevelIdeas.map((idea) => (
            <a class="backlink" href={url(idea.id)}>
              <div class="bl-kind">{cap(idea.data.status)}</div>
              <h4>{idea.data.title}</h4>
              {idea.data.description && <p>{idea.data.description}</p>}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
