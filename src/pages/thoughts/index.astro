---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getCollection } from "astro:content"

const thoughts = await getCollection("thoughts")
const sortedThoughts = thoughts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const shortDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })
---

<BaseLayout
  title="Thoughts"
  description="Short-form reflections, observations, and developing ideas."
  contained={false}
>
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">Marginalia</span>
      <h1>Thoughts</h1>
      <p class="page-lead">Short reflections and observations, dated as they land on the page.</p>
    </div>
  </div>

  <section class="section-sm">
    <div class="container">
      {
        sortedThoughts.length > 0 ? (
          <div class="backlinks">
            {sortedThoughts.map((thought) => (
              <a class="backlink" href={`/thoughts/${thought.id}/`}>
                <div class="bl-kind">{shortDate(thought.data.date)}</div>
                <h4>{thought.data.title}</h4>
              </a>
            ))}
          </div>
        ) : (
          <p class="caption">No thoughts yet. This is a new section.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
