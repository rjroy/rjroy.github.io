---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getCollection } from "astro:content"

const allWriting = await getCollection("writing")

// Get series index pages (Astro strips "/index" from IDs, so top-level entries have no "/" in their ID)
const seriesEntries = allWriting
  .filter((entry) => !entry.id.includes("/"))
  .sort((a, b) => {
    // Sort by date desc (entries without dates go last)
    if (a.data.date && b.data.date) return b.data.date.getTime() - a.data.date.getTime()
    if (a.data.date) return -1
    if (b.data.date) return 1
    return a.data.title.localeCompare(b.data.title)
  })

function entryIdToUrl(entryId: string): string {
  return `/writing/${entryId}/`
}
---

<BaseLayout title="Writing" description="Essays and longer-form pieces">
  <h1>Writing</h1>
  <p class="text-[var(--color-text-muted)] mb-8">
    Essays, series, and longer-form pieces.
  </p>

  <div class="space-y-4">
    {seriesEntries.map((piece) => (
      <a href={entryIdToUrl(piece.id)} class="card block p-4 no-underline">
        <h2 class="text-lg mb-1">{piece.data.title}</h2>
        {piece.data.date && (
          <time
            datetime={piece.data.date.toISOString()}
            class="text-xs text-[var(--color-text-muted)] block mb-1"
          >
            {piece.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
            })}
          </time>
        )}
        {piece.data.description && (
          <p class="text-sm text-[var(--color-text-muted)] mb-0">{piece.data.description}</p>
        )}
      </a>
    ))}
  </div>
</BaseLayout>
