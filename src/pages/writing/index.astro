---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getCollection } from "astro:content"

const allWriting = await getCollection("writing")

// Series index pages only (Astro strips "/index", so top-level entries have no "/" in their ID)
const seriesEntries = allWriting
  .filter((entry) => !entry.id.includes("/"))
  .sort((a, b) => {
    if (a.data.date && b.data.date) return b.data.date.getTime() - a.data.date.getTime()
    if (a.data.date) return -1
    if (b.data.date) return 1
    return a.data.title.localeCompare(b.data.title)
  })

const url = (id: string) => `/writing/${id.toLowerCase()}/`
const shortDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })
---

<BaseLayout title="Writing" description="Essays, series, and longer-form pieces." contained={false}>
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">The library</span>
      <h1>Writing</h1>
      <p class="page-lead">
        Essays and longer pieces I've thought all the way through before publishing — some
        standalone, some gathered into series.
      </p>
    </div>
  </div>

  <section class="section-sm">
    <div class="container">
      <div class="backlinks">
        {
          seriesEntries.map((piece) => (
            <a class="backlink" href={url(piece.id)}>
              <div class="bl-kind">{piece.data.date ? shortDate(piece.data.date) : "Essay"}</div>
              <h4>{piece.data.title}</h4>
              {piece.data.description && <p>{piece.data.description}</p>}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
