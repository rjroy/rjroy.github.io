---
import { getCollection, render } from "astro:content"
import WritingLayout from "../../layouts/WritingLayout.astro"

export async function getStaticPaths() {
  const writing = await getCollection("writing")
  return writing.map((entry) => {
    let slug = entry.id.toLowerCase()
    if (slug.endsWith("/index")) {
      slug = slug.replace(/\/index$/, "")
    }
    return {
      params: { slug },
      props: { entry },
    }
  })
}

const { entry } = Astro.props
const { Content } = await render(entry)

// Rough reading time from the raw markdown (~200 wpm).
const words = entry.body?.trim().split(/\s+/).filter(Boolean).length ?? 0
const readingMinutes = words > 0 ? Math.max(1, Math.round(words / 200)) : 0
---

<WritingLayout
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  tags={entry.data.tags}
  id={entry.id}
  readingMinutes={readingMinutes}
>
  <Content />
</WritingLayout>
